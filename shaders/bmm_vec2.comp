#version 450
// Batched out = alpha * A @ B, vec4 loads along k for A and B: attention context (Codex 2026-10-15). Else as bmm.comp.
// u: 0 Bt 1 M 2 N 3 K | 4 A, 5 sAb, 6 sAm, 7 sAk | 8 B, 9 sBb, 10 sBk, 11 sBn | 12 out, 13 sOb, 14 sOm, 15 sOn | 16 alpha
layout(local_size_x = 256) in;
#include "common.glsl"
#define LDA(base, idx) a[int(base) + (idx)]
void main() {
    uint M = p.u[1], N = p.u[2], K = p.u[3], qm = (M + 3u) / 4u, qn = (N + 3u) / 4u, i = tid();
    if (i >= p.u[0] * qm * qn) return;
    uint b = i / (qm * qn), r = i % (qm * qn), m0 = (r % qm) * 4u, n0 = (r / qm) * 4u;
    uint Ab = p.u[4], Bb = p.u[8];
    int A0 = int(b) * int(p.u[5]), B0 = int(b) * int(p.u[9]);
    int sAm = int(p.u[6]), sAk = int(p.u[7]), sBk = int(p.u[10]), sBn = int(p.u[11]);
    int am[4], bn[4];
    am[0] = A0 + int(min(m0, M - 1u)) * sAm; am[1] = A0 + int(min(m0 + 1u, M - 1u)) * sAm;
    am[2] = A0 + int(min(m0 + 2u, M - 1u)) * sAm; am[3] = A0 + int(min(m0 + 3u, M - 1u)) * sAm;
    bn[0] = B0 + int(min(n0, N - 1u)) * sBn; bn[1] = B0 + int(min(n0 + 1u, N - 1u)) * sBn;
    bn[2] = B0 + int(min(n0 + 2u, N - 1u)) * sBn; bn[3] = B0 + int(min(n0 + 3u, N - 1u)) * sBn;
    int a0 = am[0], a1 = am[1], a2 = am[2], a3 = am[3], c0 = bn[0], c1 = bn[1], c2 = bn[2], c3 = bn[3];
    vec4 s0 = vec4(0.0), s1 = vec4(0.0), s2 = vec4(0.0), s3 = vec4(0.0);   // s_n = (m0..m3)
    uint k = 0u;
    for (; k + 4u <= K; k += 4u) {
        vec4 x0 = a4[(int(Ab) + a0 + int(k)) / 4];
        vec4 x1 = a4[(int(Ab) + a1 + int(k)) / 4];
        vec4 x2 = a4[(int(Ab) + a2 + int(k)) / 4];
        vec4 x3 = a4[(int(Ab) + a3 + int(k)) / 4];
        vec4 y = a4[(int(Bb) + c0 + int(k)) / 4];
        s0 += vec4(dot(x0,y), dot(x1,y), dot(x2,y), dot(x3,y));
        y = a4[(int(Bb) + c1 + int(k)) / 4];
        s1 += vec4(dot(x0,y), dot(x1,y), dot(x2,y), dot(x3,y));
        y = a4[(int(Bb) + c2 + int(k)) / 4];
        s2 += vec4(dot(x0,y), dot(x1,y), dot(x2,y), dot(x3,y));
        y = a4[(int(Bb) + c3 + int(k)) / 4];
        s3 += vec4(dot(x0,y), dot(x1,y), dot(x2,y), dot(x3,y));
    }
    for (; k < K; k++) {
        int ka = int(k) * sAk, kb = int(k) * sBk;
        vec4 x = vec4(LDA(Ab, a0 + ka), LDA(Ab, a1 + ka), LDA(Ab, a2 + ka), LDA(Ab, a3 + ka));
        s0 += LDA(Bb, c0 + kb) * x; s1 += LDA(Bb, c1 + kb) * x; s2 += LDA(Bb, c2 + kb) * x; s3 += LDA(Bb, c3 + kb) * x;
    }
    float al = uintBitsToFloat(p.u[16]);
    int ob = int(p.u[12]) + int(b) * int(p.u[13]), sOm = int(p.u[14]), sOn = int(p.u[15]);
#define PUT(j, J) if (n0 + J < N) { int o = ob + int(n0 + J) * sOn + int(m0) * sOm; a[o] = al * s##j.x; \
    if (m0 + 1u < M) a[o + sOm] = al * s##j.y; if (m0 + 2u < M) a[o + 2 * sOm] = al * s##j.z; if (m0 + 3u < M) a[o + 3 * sOm] = al * s##j.w; }
    PUT(0, 0u) PUT(1, 1u) PUT(2, 2u) PUT(3, 3u)
}
